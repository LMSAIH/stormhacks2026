# Copy to .env.local (gitignored) and fill in. Vite bakes VITE_* values into the bundle at build
# time, so never put secrets here.

# "accuracy" mode: base URL of the hosted lip-read service (beam search + LM on a GPU pod), no
# trailing slash. The app calls GET {url}/health and POST {url}/lipread/crops.
# Leave empty to disable accuracy mode (speed mode runs fully in the browser).
# Current RunPod URL: see .context/project-brief.md §11. Local dev server: http://127.0.0.1:8000
VITE_LIPREAD_URL=

# "speed" mode model files. Default (unset): the pinned Hugging Face repo
# eschmechel/auto-avsr-lrs3-vsr-int8-onnx, cached by the browser after the first 203 MB download.
# Set to /models to serve them from public/models/ instead (offline; run
# ../ml/scripts/publish_frontend_model.sh first).
# VITE_LIPREAD_MODEL_BASE=/models

# Opt in to the WebGPU EP for the on-device int8 model (off by default: WASM is the tested path).
# It reads correctly on WebGPU where an adapter exists; with none (or on any failure) the app falls
# back to WASM. For benchmarking.
# VITE_ORT_WEBGPU=1
