# Copy to .env.local (gitignored) and fill in. Vite bakes VITE_* values into the bundle at build
# time, so never put secrets here.

# "accuracy" mode: base URL of the hosted lip-read service (beam search + LM on a GPU pod), no
# trailing slash. The app calls GET {url}/health and POST {url}/lipread/crops.
# Leave empty to disable accuracy mode (speed mode runs fully in the browser).
# Current RunPod URL: see .context/project-brief.md §11. Local dev server: http://127.0.0.1:8000
VITE_LIPREAD_URL=

# Opt in to the WebGPU EP (off by default: it rejects the model's Conv3D padding).
# VITE_ORT_WEBGPU=1
