# Optional
# DIARIZATION=1                # speaker labels in /ws/stt (see diarization/README.md)
# TTS_BACKEND=flash            # flash | v4
# TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# TTS_MODEL_ID=
# TTS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=generate-a-long-random-value
API_PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HTTPS_ONLY=false
TIMESCALE_SERVICE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
